#!/usr/bin/env python3
"""Run the Doorman brief CLI from any working directory.

Usage:
  ./brief list
  ./brief migrate-data --brief torana-line-crm

Equivalent to (from ~/.openclaw/skills only):
  PYTHONPATH=. python3 -m _outreach_core.helpers.brief list
"""
from __future__ import annotations

import runpy
import sys
from pathlib import Path

_SKILLS_ROOT = Path(__file__).resolve().parent
if str(_SKILLS_ROOT) not in sys.path:
    sys.path.insert(0, str(_SKILLS_ROOT))

runpy.run_module("_outreach_core.helpers.brief", run_name="__main__")
