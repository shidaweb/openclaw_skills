# OS / editor cruft
.DS_Store
*.swp
*.swo
.idea/
.vscode/

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
*.egg-info/

# Skill local state (per-machine, not for sharing)
data/*.jsonl
data/*.txt
data/sample_*.txt

# Skill config containing personal info (sender details, calendar URL, etc)
# Always commit config.example.yaml — never the filled-in config.yaml
config.yaml
sender_brief.yaml
briefs/*.yaml
!briefs/_template.yaml
!briefs/*.example.yaml
targets.yaml
targets.csv
targets.csv.bak

# Slack channel ↔ brief bindings (per workspace)
data/channel_state/C*.json

# Shared core runtime data
_outreach_core/data/
data/system_health/
data/watchdog.log
data/watchdog.err
data/watchdog.state.json
data/job_logs/

# Per-skill escalation / progress logs
**/data/needs_attention.jsonl
**/data/current_task.jsonl
**/data/events.jsonl
**/data/traces/
**/data/verify_snapshot_*.txt

# --- v6 hardening: keep runtime data, real target lists, and backups out of git ---
# All per-skill/per-brief runtime data dirs (drafts, histories, snapshots, stats,
# resolve_queue, run_supervisor state). These contain prospect contact info and
# drafted message bodies — never commit.
**/data/
data/run_supervisor.json
# Filled-in target lists (per-brief). Commit only the *.example.* templates.
*/targets/*.yaml
*/targets/*.csv
!*/targets/*.example.yaml
!*/targets/*.example.csv
# Editor/script backups and stray local scripts
**/*.backup.*
linkedin-outreach/loop_until_10.sh

# --- Per-client local overrides (distribution: keep client identity out of git) ---
# Real persona / few-shot examples with sender identity, case studies, calendar URL.
# Ship only the neutral templates (system_persona.md / examples.md); each client
# keeps its tuned copy as *.local.md (loader prefers it automatically).
**/prompts/*.local.md
personas/*.yaml
!personas/_template.yaml
!personas/*.example.yaml
# Active-brief pointer is per-client (which brief this install runs).
briefs/_active.txt

# --- Local-only operational assets (never commit) ---
# API keys / tokens / local env
.env
.env.*
*.env
**/secrets*.yaml
**/credentials*.json
**/service-account*.json

# Filled sender/runtime configs (examples are tracked)
**/config.yaml
**/sender_brief.yaml

# Real briefs are local-only; keep only template/example in git
briefs/*.yaml
!briefs/_template.yaml
!briefs/*.example.yaml

# Target lists are local-only; keep only example templates
**/targets/*.yaml
**/targets/*.csv
**/targets/*.bak*
!**/targets/*.example.yaml
!**/targets/*.example.csv

# Slack channel binding/state is local-only
**/data/channel_state/*.json

# v20: machine-local primary-host guard config (never commit)
data/primary_host
data/pw_profile/
data/pw_shot_*.png
data/run_progress.json
data/run_progress.html

# per-client persona prompts not meant for the public repo
jp-form-outreach/prompts/channeltalk-clinic/
