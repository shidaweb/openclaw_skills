#!/usr/bin/env python3
"""Run the Doorman detached job runner from any working directory.

Usage:
  ./job start jp-form-outreach campaign --brief torana-line-crm --limit 5
  ./job start linkedin-outreach send --brief torana-line-crm --ids 1,3 --auto-send
"""
from __future__ import annotations

import runpy
import sys
from pathlib import Path

_SKILLS_ROOT = Path(__file__).resolve().parent
if str(_SKILLS_ROOT) not in sys.path:
    sys.path.insert(0, str(_SKILLS_ROOT))

runpy.run_module("_outreach_core.helpers.run_job", run_name="__main__")
